# ── Required ─────────────────────────────────────────────────
DB_HOST=your-cloud-sql-ip-or-unix-socket
DB_PORT=3306
DB_USER=safenest
DB_PASS=your-secure-password
DB_NAME=safenest

# ── Optional: set to "true" for Cloud SQL connections with SSL ─
DB_SSL=false

# ── JWT ───────────────────────────────────────────────────────
JWT_SECRET=replace-with-a-long-random-string-min-32-chars

# ── Server ───────────────────────────────────────────────────
PORT=3009
NODE_ENV=development
